---
/**
 * Header, footer and <head> for every page. The page fetches the brand (`site`)
 * and the visitor (`viewer`) with `pageContext` and passes them in, so the
 * layout never makes an API call of its own.
 *
 * Sign in, sign up, joining and the community itself are App pages on this
 * same hostname: always plain `<a href>`, never a client-side route.
 */
import '../styles/global.css';

import BrandMark from '../components/BrandMark.astro';
import {NAV} from '../content/site';
import type {Site, Viewer} from '../lib/types';
import {initials} from '../lib/format';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The page's own name; the tab shows "<title> · <community>". Omit on home. */
  title?: string;
  description?: string;
  /** Extra <head> tags, e.g. og:image on a post. */
  image?: string | null;
  /**
   * A PRERENDERED page (`export const prerender = true`): built once, served
   * as a static file, so it knows no visitor. The header then renders the
   * signed-out view and the browser fills in the visitor (`/site-api/me`) and
   * a renamed community (`/site-api/site`) after load.
   */
  isStatic?: boolean;
}

const {site, viewer, title, description, image, isStatic = false} = Astro.props;
const name = site?.name ?? 'Pach Vai';
const fullTitle = title ? `${title} · ${name}` : name;
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
// Back to this page after signing in. A PATH only: the App ignores full URLs.
const back = encodeURIComponent(`${path}${Astro.url.search}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title ?? name} />
    {image && <meta property="og:image" content={image} />}
    {site?.favIcon && <link rel="icon" href={site.favIcon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-viewer={viewer.state} data-static={isStatic ? '1' : undefined}>
    <header class="site-header" data-site-header>
      <div class="wrap site-header-inner">
        <a href="/" class="brand">
          <BrandMark site={site} />
          <span class="brand-name" data-brand-text="{name}" data-built-name={name}>{name}</span>
        </a>
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu">
          <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          {NAV.map(item =>
            item.href === '/blog' ? (
              <div class="nav-item-has-drop">
                <a href={item.href} class:list={{active: active(item.href)}} aria-haspopup="true">
                  {item.label}
                  <span class="nav-drop-caret" aria-hidden="true">▾</span>
                </a>
                <div class="nav-drop" data-blog-drop role="menu" aria-label="Blog posts">
                  <a class="nav-drop-view-all" href="/blog" role="menuitem">View all posts</a>
                </div>
              </div>
            ) : (
              <a href={item.href} class:list={{active: active(item.href)}}>
                {item.label}
              </a>
            )
          )}
          <a
            href="/portal"
            class:list={{active: active('/portal')}}
            data-member-only
            hidden={viewer.state !== 'member'}>
            Dashboard
          </a>
        </nav>
        <div class="session" data-session>
          {viewer.state === 'member' ? (
            <>
              <a class="button ghost small-button" href="/feeds">
                Community
              </a>
              <span class="viewer" title={viewer.name ?? ''}>
                {viewer.avatar ? (
                  <img src={viewer.avatar} alt="" width="28" height="28" />
                ) : (
                  <span class="avatar-fallback" aria-hidden="true">
                    {initials(viewer.name ?? '')}
                  </span>
                )}
              </span>
              {viewer.preview ? (
                <span class="chip" title="Editor preview: a stand-in signed-in member">Preview</span>
              ) : (
                <button class="button link small-button" type="button" data-logout>
                  Sign out
                </button>
              )}
            </>
          ) : viewer.state === 'applicant' ? (
            <a class="button small-button" href="/join">
              Finish joining
            </a>
          ) : (
            <>
              <a class="button link small-button" href={`/login?redirectTo=${back}`}>
                Log in
              </a>
              <a class="button small-button" href={`/register?redirectTo=${back}`}>
                Join
              </a>
            </>
          )}
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <span data-brand-text="© {year} {name}">© {new Date().getUTCFullYear()} {name}</span>
        <nav class="footer-nav" aria-label="Footer">
          {NAV.map(item => <a href={item.href}>{item.label}</a>)}
          <a href="/feeds">Community</a>
        </nav>
      </div>
    </footer>

    <script>
      import {logout, refreshSession} from '../platform/browser';
      import {hydrateStaticPage} from '../platform/static-page';

      if (document.body.dataset.static === '1') void hydrateStaticPage();

      // The server saw an expired access token but a refresh cookie: refresh
      // ONCE in the browser (the server never does), then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }

      // Blog nav dropdown: fetch recent posts and show them as sub-links.
      const blogDrop = document.querySelector<HTMLElement>('[data-blog-drop]');
      if (blogDrop) {
        const dropParent = blogDrop.closest<HTMLElement>('.nav-item-has-drop');
        let loaded = false;

        const loadPosts = async () => {
          if (loaded) return;
          loaded = true;
          try {
            const res = await fetch('/site-api/posts?perPage=8');
            const data: {posts?: {slug: string; title: string}[]} = res.ok ? await res.json() : {};
            const posts = data.posts ?? [];
            if (posts.length === 0) return;
            const frag = document.createDocumentFragment();
            const hr = document.createElement('hr');
            hr.className = 'nav-drop-divider';
            hr.setAttribute('aria-hidden', 'true');
            frag.appendChild(hr);
            for (const post of posts) {
              const a = document.createElement('a');
              a.href = `/blog/${encodeURIComponent(post.slug)}`;
              a.setAttribute('role', 'menuitem');
              a.textContent = post.title;
              frag.appendChild(a);
            }
            blogDrop.appendChild(frag);
          } catch {
            // Leave "View all posts" link only.
          }
        };

        // Desktop: load lazily on first hover.
        dropParent?.addEventListener('mouseenter', loadPosts);

        // Mobile: tap the Blog link to expand/collapse the submenu.
        dropParent?.querySelector('a')?.addEventListener('click', e => {
          if (window.innerWidth > 860) return;
          e.preventDefault();
          void loadPosts();
          if (dropParent.hasAttribute('data-drop-open')) {
            dropParent.removeAttribute('data-drop-open');
          } else {
            dropParent.setAttribute('data-drop-open', '');
          }
        });
      }

      // The phone nav: a ghost menu button toggles the link list open/closed.
      const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      navToggle?.addEventListener('click', () => {
        const open = header?.dataset.navOpen === undefined;
        if (open) header!.dataset.navOpen = '';
        else delete header!.dataset.navOpen;
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      // A link was followed: close the drawer so the next page starts fresh.
      document.querySelector('.site-nav')?.addEventListener('click', event => {
        if (event.target instanceof HTMLAnchorElement) delete header?.dataset.navOpen;
      });

      // Every button shows when it is busy (AGENTS.md "Buttons and forms").
      const busy = (button: HTMLButtonElement, label?: string) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (label) button.textContent = label;
      };

      document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach(button =>
        button.addEventListener('click', () => {
          busy(button, 'Signing out…');
          void logout();
        })
      );

      // A search / filter form (GET) navigates: show its button busy until the next page.
      document.addEventListener('submit', event => {
        const form = event.target;
        if (event.defaultPrevented || !(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== 'get') return;
        if (event.submitter instanceof HTMLButtonElement) busy(event.submitter);
      });
      // Back/forward restores a page from memory: give its buttons back.
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLButtonElement>('button[aria-busy="true"]').forEach(button => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      });
    </script>
  </body>
</html>
