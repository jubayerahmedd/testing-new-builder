---
/**
 * The home page: PRERENDERED (built once, served as a static file, no server
 * work per visit) and made of sections. Words in `src/content/site.ts`.
 *
 * What changes often is filled in by the browser after load, from the Site API:
 *   - the visitor (`<Base isStatic>`): members see "Your dashboard"
 *     (`data-member-only`), guests "Join the table" (`data-guest-only`)
 *   - latest news (a `data-live` section, below)
 * A section with no data stays hidden.
 */
import {HOME} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic>
  <main>
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-text">
          <p class="eyebrow">{HOME.hero.eyebrow}</p>
          <h1>{HOME.hero.title}</h1>
          <p class="lede">{HOME.hero.body}</p>
          <div class="actions" data-guest-only>
            <a class="button large" href="/visit">Book a table</a>
            <a class="button ghost large" href="/menu">See the menu</a>
          </div>
          <div class="actions" data-member-only hidden>
            <a class="button large" href="/visit">Book a table</a>
            <a class="button ghost large" href="/portal">Your dashboard</a>
          </div>
          <ul class="fact-strip">
            {
              HOME.strip.map(fact => (
                <li>
                  <span class="fact-label">{fact.label}</span>
                  <span class="fact-value">{fact.value}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="hero-image">
          <img class="photo-frame hero-photo" src={HOME.heroImage.src} alt={HOME.heroImage.alt} loading="eager" />
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <div>
          <p class="eyebrow">{HOME.specials.eyebrow}</p>
          <h2>{HOME.specials.title}</h2>
        </div>
        <a href="/menu">Full menu →</a>
      </div>
      <p class="lede section-intro">{HOME.specials.body}</p>
      <div class="grid grid-3">
        {
          HOME.specials.items.map(dish => (
            <article class="special-card">
              <img class="special-photo" src={dish.image.src} alt={dish.image.alt} loading="lazy" />
              <div class="special-body">
                <div class="special-head">
                  <h3>{dish.name}</h3>
                  <span class="special-price">{dish.price}</span>
                </div>
                {dish.badge && <span class="badge">{dish.badge}</span>}
                <p class="muted">{dish.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-band">
      <div class="wrap section" data-live="posts" hidden>
        <div class="section-head">
          <h2>From the kitchen</h2>
          <a href="/blog">All stories →</a>
        </div>
        <div class="grid grid-3" data-list></div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head-center">
        <p class="eyebrow">{HOME.reviews.eyebrow}</p>
        <h2>{HOME.reviews.title}</h2>
      </div>
      <div class="grid grid-3">
        {
          HOME.reviews.items.map(review => (
            <figure class="review-card">
              <blockquote class="review-quote">{review.quote}</blockquote>
              <figcaption class="review-byline">
                <div>
                  <strong>{review.author}</strong>
                  <span class="muted small">{review.role}</span>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="band-dark">
      <div class="wrap section center">
        <h2>{HOME.cta.title}</h2>
        <p class="lede">{HOME.cta.body}</p>
        <div class="actions">
          <a class="button large" href="/visit">Get directions &amp; call</a>
          <a class="button ghost large" href="/menu">Browse the menu</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import {formatDate} from '../lib/format';
  import type {PostsPage} from '../lib/types';

  /** One element with text: never HTML from an answer. */
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  async function live<T>(name: string, path: string, render: (data: T, list: HTMLElement) => number) {
    const section = document.querySelector<HTMLElement>(`[data-live="${name}"]`);
    const list = section?.querySelector<HTMLElement>('[data-list]');
    if (!section || !list) return;
    try {
      const res = await fetch(path, {headers: {accept: 'application/json'}});
      if (!res.ok) return;
      if (render((await res.json()) as T, list) > 0) section.hidden = false;
    } catch {
      // The section stays hidden: the page is complete without it.
    }
  }

  void live<PostsPage>('posts', '/site-api/posts?perPage=3', (data, list) => {
    for (const post of data.posts) {
      const card = el('a', 'post-card');
      card.href = `/blog/${encodeURIComponent(post.slug)}`;
      if (post.coverUrl) {
        const img = el('img', 'cover');
        img.src = post.coverUrl;
        img.alt = '';
        img.loading = 'lazy';
        card.append(img);
      } else {
        card.append(el('span', 'cover cover-empty'));
      }
      const body = el('div', 'post-card-body');
      body.append(el('h3', '', post.title));
      if (post.excerpt) body.append(el('p', 'muted small', post.excerpt.slice(0, 110)));
      body.append(el('p', 'meta', formatDate(post.publishedAt)));
      card.append(body);
      list.append(card);
    }
    return data.posts.length;
  });
</script>
